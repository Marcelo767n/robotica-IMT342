<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Seis juntas revolutas (un único origin por grado de libertad) y seis marcos
    móviles. base_link es el marco base y no cuenta como junta. Los visuales son
    meshes STL ya expresados en el marco de su eslabón: no llevan origin propio.
    La pinza se acopla a tool0 con dos juntas fijas (no son grados de libertad).

    Para DH clásico A_i(q_i)=Rz(q_i) B_i, donde
    B_i=Tz(d_i) Tx(a_i) Rx(alpha_i). URDF aplica en cada junta
    O_i Rz(q_i), por lo que el B de una fila se incorpora al origin de la
    junta siguiente. Los offsets de theta también se incluyen en esos origins.

    La sexta fila puede cerrarse sin una junta fija porque a6=alpha6=0 y
    Tz(d6) conmuta con Rz(q6). Así, tool0 es directamente el hijo de joint_6.
  -->
  <xacro:property name="gripper_tcp_z" value="0.100"/>
  <xacro:macro name="irb120_robot" params="prefix:=''">
    <link name="${prefix}base_link">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/base_link.stl"/></geometry>
        <material name="abb_dark"/>
      </visual>
    </link>

    <!-- J1: O1=I. -->
    <link name="${prefix}link_1">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/link_1.stl"/></geometry>
        <material name="abb_orange"/>
      </visual>
    </link>
    <joint name="${prefix}joint_1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8797932658" upper="2.8797932658" effort="100" velocity="4.3633231300"/>
    </joint>

    <!-- J2: O2=B1 Rz(-pi/2). -->
    <link name="${prefix}link_2">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/link_2.stl"/></geometry>
        <material name="abb_orange"/>
      </visual>
    </link>
    <joint name="${prefix}joint_2" type="revolute">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin xyz="0 0 0.290" rpy="${-pi/2} ${-pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.9198621772" upper="1.9198621772" effort="100" velocity="4.3633231300"/>
    </joint>

    <!-- J3: O3=B2=Tx(0.270). -->
    <link name="${prefix}link_3">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/link_3.stl"/></geometry>
        <material name="abb_orange"/>
      </visual>
    </link>
    <joint name="${prefix}joint_3" type="revolute">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin xyz="0.270 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.9198621772" upper="1.2217304764" effort="100" velocity="4.3633231300"/>
    </joint>

    <!-- J4: O4=B3=Tx(0.070) Rx(-pi/2). -->
    <link name="${prefix}link_4">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/link_4.stl"/></geometry>
        <material name="abb_orange"/>
      </visual>
    </link>
    <joint name="${prefix}joint_4" type="revolute">
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <origin xyz="0.070 0 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.7925268032" upper="2.7925268032" effort="100" velocity="5.5850536064"/>
    </joint>

    <!-- J5: O5=B4=Tz(0.302) Rx(pi/2). -->
    <link name="${prefix}link_5">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/link_5.stl"/></geometry>
        <material name="abb_orange"/>
      </visual>
    </link>
    <joint name="${prefix}joint_5" type="revolute">
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <origin xyz="0 0 0.302" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0943951024" upper="2.0943951024" effort="100" velocity="5.5850536064"/>
    </joint>

    <!-- J6: O6=B5 Rz(pi) Tz(0.072). tool0 es el sexto marco móvil. -->
    <link name="${prefix}tool0">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/tool0.stl"/></geometry>
        <material name="metal"/>
      </visual>
    </link>
    <joint name="${prefix}joint_6" type="revolute">
      <parent link="${prefix}link_5"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0.072 0" rpy="${pi/2} 0 ${pi}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.9813170080" upper="6.9813170080" effort="100" velocity="7.3303828584"/>
    </joint>

    <!-- Pinza neumática: gripper_link comparte el marco de tool0 (sin origin). -->
    <link name="${prefix}gripper_link">
      <visual>
        <geometry><mesh filename="package://irb120_hito1/meshes/gripper_link.stl"/></geometry>
        <material name="abb_dark"/>
      </visual>
    </link>
    <joint name="${prefix}gripper_mount" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}gripper_link"/>
    </joint>

    <!-- TCP: centro de agarre entre los dedos, 0.100 m sobre la brida. -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0 ${gripper_tcp_z}"/>
    </joint>
  </xacro:macro>
</robot>
