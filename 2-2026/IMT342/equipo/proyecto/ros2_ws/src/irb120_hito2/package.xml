<?xml version="1.0"?>
<package format="3">
  <name>irb120_hito2</name>
  <version>0.1.0</version>
  <description>Cinematica inversa de Pieper, perfiles LSPB y analisis de singularidad del ABB IRB 120.</description>

  <maintainer email="equipo.imt342@example.com">Equipo IMT-342</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>irb120_hito1</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
